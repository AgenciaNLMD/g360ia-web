:{$PORT} {
	# --- API del chatbot: proxy al servicio Node que guarda la key ---
	# (el servicio escucha solo en 127.0.0.1:8787, no está expuesto a internet)
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	# --- Sitio estático ---
	handle {
	root * /app/dist
	encode zstd gzip

	# --- Canonicalización: una sola versión de cada URL ---
	# Canónica = https://g360ia.com.ar/... (sin www, sin /index, sin .html)
	# Los <link rel="canonical"> del HTML ya apuntan ahí; esto lo fuerza con 301.

	# 1) www -> apex, siempre en UN solo salto (sin cadenas de redirección).
	# Las reglas de www que normalizan el path van primero: si sólo estuviera la
	# genérica, www/index haría 301 a apex/index y recién ahí a / (dos saltos).
	# Entre redir del mismo tipo, Caddy respeta el orden del archivo.

	# 1a) www + /index(.html) -> raíz del apex
	@www_index {
		host www.g360ia.com.ar
		path /index /index.html
	}
	redir @www_index https://g360ia.com.ar/ permanent

	# 1b) www + /algo.html -> apex /algo
	@www_html {
		host www.g360ia.com.ar
		path_regexp wwwhtml ^/(.+)\.html$
		not path /partials/*
	}
	redir @www_html https://g360ia.com.ar/{re.wwwhtml.1} permanent

	# 1c) www, resto de las URLs -> apex tal cual
	@www host www.g360ia.com.ar
	redir @www https://g360ia.com.ar{uri} permanent

	# 2) /index y /index.html -> /
	redir /index / permanent
	redir /index.html / permanent

	# 3) /software-para-veterinarias -> el sitio del producto
	# La landing se borró el 16-sep-2026: el que busca el software para
	# veterinarias quiere entrar al software, no leer una página intermedia que
	# repite lo que vet.g360ia.com.ar ya cuenta mejor. La URL no se puede dejar
	# morir en un 404 —está indexada y la escriben los mails del turnero
	# (lib/email-textos.js)—, así que hace 301 y le pasa la señal al producto.
	# Va ANTES de la regla genérica de .html para que la forma con extensión
	# llegue en un solo salto y no encadene dos redirecciones.
	@vet path /software-para-veterinarias /software-para-veterinarias.html
	redir @vet https://vet.g360ia.com.ar permanent

	# 3b) /contacto -> home, sección de contacto
	# La página /contacto existió en el origen del sitio y se borró hace años;
	# hoy el contacto es la sección #contacto de la home (secciones-home.jsx).
	# Sigue indexada/enlazada desde campañas viejas (Search Console la marca
	# 404 con querystrings tipo ?servicio=...&plan=...) así que en vez de
	# dejarla morir en un 404 manda a la sección real. Los query params se
	# pierden a propósito: no hay nada del otro lado que los consuma.
	redir /contacto /#contacto permanent

	# 4) /loquesea.html -> /loquesea
	# /partials/* queda excluido: no son páginas, son fragmentos que se piden por fetch
	# (ver Regla 4 / footer compartido). Redirigirlos sólo agrega un salto a cada carga.
	@htmlext {
		path_regexp htmlext ^/(.+)\.html$
		not path /partials/*
	}
	redir @htmlext /{re.htmlext.1} permanent

	# Assets con hash en el nombre: cachear un año, inmutables
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# Imágenes y estáticos sin hash: 30 días
	@media path *.webp *.png *.jpg *.jpeg *.ico *.svg *.woff2
	header @media Cache-Control "public, max-age=2592000"

	# URLs limpias: /servicios/ads sirve servicios/ads.html (coincide con los canonical).
	# El orden importa: {path}.html y {path}/index.html van ANTES que {path}, porque si
	# {path} matchea primero un directorio (ej. /blog -> dist/blog/), file_server responde
	# 308 a /blog/ y el sitemap/canonical (que declaran /blog) quedarían apuntando a una
	# URL que redirige.
	try_files {path}.html {path}/index.html {path} {path}/

	file_server
	}
}

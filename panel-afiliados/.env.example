# Copiar a .env (local) o cargar como variables del servicio en Easypanel.

# La base del catálogo. Propia de este proyecto: no se comparte con el turnero.
DATABASE_URL=postgres://usuario:clave@localhost:5432/g360ia_catalogo

# El origen público. Tiene que coincidir con lo declarado en Google Cloud.
APP_URL=https://afiliados.g360ia.com.ar

# Credenciales de Google Cloud → APIs y servicios → Credenciales →
# ID de cliente de OAuth 2.0 (tipo «Aplicación web»). Ver DESPLIEGUE.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firma de la cookie de sesión. Generar con: openssl rand -hex 32
# Si cambia, se cierran todas las sesiones abiertas.
SESION_SECRETO=
